profile undocked {
  output "BOE*" enable mode 1920x1080@60.0
  exec ~/.config/kanshi/ws-to-monitor.sh 1 eDP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 2 eDP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 3 eDP-1
}

profile work-dual {
  output "BOE*" enable position 0,0
  output "Dell Inc. DELL P3424WE*" enable position 1920,0
  exec ~/.config/kanshi/ws-to-monitor.sh 1 DP-5
  exec ~/.config/kanshi/ws-to-monitor.sh 2 DP-5
  exec ~/.config/kanshi/ws-to-monitor.sh 3 eDP-1
}

profile work {
  output "Dell Inc. DELL P3424WE*" enable
  output "BOE*" disable
  exec ~/.config/kanshi/ws-to-monitor.sh 1 DP-5
  exec ~/.config/kanshi/ws-to-monitor.sh 2 DP-5
  exec ~/.config/kanshi/ws-to-monitor.sh 3 DP-5
}

profile home-tv {
  output "Dell Inc. Dell AW3821DW*" enable
  output "VIZIO*" enable
  exec ~/.config/kanshi/ws-to-monitor.sh 1 DP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 2 DP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 3 HDMI-A-1
}

profile home {
  output "Dell Inc. Dell AW3821DW*" enable
  output "VIZIO*" disable
  exec ~/.config/kanshi/ws-to-monitor.sh 1 DP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 2 DP-1
  exec ~/.config/kanshi/ws-to-monitor.sh 3 DP-1
}

profile room {
  output "BOE*" enable
  output "*" enable
}
